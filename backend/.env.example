# =============================================================================
# CivicConnect Backend — Required Environment Variables
# =============================================================================
# Copy this file to application-local.properties (see that file's template)
# OR export these as environment variables before running the application.
#
# NEVER commit real credentials. application-local.properties is gitignored.
# =============================================================================

# ── Supabase PostgreSQL (direct connection, port 5432) ───────────────────────
# Find these at: Supabase Dashboard → Project Settings → Database
SUPABASE_DB_URL=jdbc:postgresql://<YOUR_DB_HOST>:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<YOUR_DB_PASSWORD>

# ── Supabase Storage & API ────────────────────────────────────────────────────
# Find these at: Supabase Dashboard → Project Settings → API
SUPABASE_PROJECT_URL=https://<YOUR_PROJECT_ID>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SERVICE_ROLE_KEY>

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret (at least 256-bit / 32 bytes).
# Example (Linux/macOS): openssl rand -hex 32
# Example (PowerShell):  [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
APP_JWT_SECRET=<YOUR_256_BIT_RANDOM_HEX_OR_BASE64_SECRET>

# Token validity in milliseconds (default 24 hours = 86400000)
APP_JWT_EXPIRATION_MS=86400000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8443
